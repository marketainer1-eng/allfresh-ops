# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/allfresh_ops?schema=public"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET="your-secret-key-here-change-in-production"

# Application URL (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# ─── Supabase Storage (Optional) ──────────────────────────────────────────────
# Used for evidence file uploads
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ─── 성과분석 해석(LLM) 엔진 (Optional) ────────────────────────────────────────
# 우선순위: Claude(권장) → OpenAI → 규칙기반 폴백. 키가 없으면 규칙기반으로 동작한다.
# Claude API 키(sk-ant-...). 설정 시 성과분석 해석이 Claude로 실행된다.
ANTHROPIC_API_KEY=""
# 해석 모델(미설정 시 claude-opus-4-8). 비용/속도 우선 시 claude-sonnet-4-6 등으로 변경 가능.
ANTHROPIC_MODEL=""
# OpenAI 폴백(선택). ANTHROPIC_API_KEY가 없을 때만 사용된다.
OPENAI_API_KEY=""

# ─── 마케팅 외부 API (Optional) ────────────────────────────────────────────────
# 키가 없으면 해당 기능은 503(미설정)으로 안내되고, 분석 자체는 계속 진행된다.
# 기상청 단기실황(공공데이터포털 data.go.kr) 인증키.
# 주의: 코드가 URLSearchParams로 인코딩하므로 "Decoding(일반 인증키)" 값을 넣어야 한다.
KMA_API_KEY=""
# KAMIS 농산물 시세 OpenAPI 인증키 / 신청 ID
KAMIS_API_KEY=""
KAMIS_CERT_ID=""
# Perplexity 실시간 시장 검색 키(pplx-...)
PERPLEXITY_API_KEY=""

# ─── App Config ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="올프레쉬 OPS"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
