generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Workspace & Users ───────────────────────────────────────────────────────

model Workspace {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  ownerEmail String   @map("owner_email")
  plan       String   @default("free")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  users            User[]
  organizations    Organization[]
  projects         Project[]
  fruits           Fruit[]
  fruitCampaigns   FruitCampaign[]
  fruitPerformances FruitPerformance[]
  fruitTasks       FruitTask[]
  fruitInsights    FruitInsight[]
  performanceAnalyses PerformanceAnalysis[]

  analyses           Analysis[]
  strategyItems      StrategyItem[]
  contentPlans       ContentPlan[]
  executionTasks     ExecutionTask[]
  marketingCampaigns MarketingCampaign[]
  demandForecasts    DemandForecast[]
  kamisMappings      KamisMapping[]
  promptTemplates    PromptTemplate[]

  @@map("workspaces")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  role         String   @default("member")
  passwordHash String?  @map("password_hash")
  avatarUrl    String?  @map("avatar_url")
  workspaceId  String   @map("workspace_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects          Project[]          @relation("CreatedProjects")
  diagnosisSessions DiagnosisSession[] @relation("CreatedSessions")
  performanceAnalyses PerformanceAnalysis[] @relation("CreatedAnalyses")

  @@map("users")
}

// ─── Organization & Project ───────────────────────────────────────────────────

model Organization {
  id           String   @id @default(cuid())
  workspaceId  String   @map("workspace_id")
  name         String
  industry     String?
  size         String?
  contactEmail String?  @map("contact_email")
  description  String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects  Project[]

  @@map("organizations")
}

model Project {
  id             String   @id @default(cuid())
  workspaceId    String   @map("workspace_id")
  organizationId String?  @map("organization_id")
  name           String
  brand          String?
  status         String   @default("active")
  description    String?  @db.Text
  tags           String[] @default([])
  createdBy      String   @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id])
  creator      User          @relation("CreatedProjects", fields: [createdBy], references: [id])
  sessions     DiagnosisSession[]

  @@map("projects")
}

// ─── Diagnosis ────────────────────────────────────────────────────────────────

model DiagnosisSession {
  id          String    @id @default(cuid())
  projectId   String    @map("project_id")
  title       String
  status      String    @default("draft")
  objective   String?   @db.Text
  periodStart DateTime? @map("period_start")
  periodEnd   DateTime? @map("period_end")
  summary     String?   @db.Text
  createdBy   String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator       User           @relation("CreatedSessions", fields: [createdBy], references: [id])
  customerFlows CustomerFlow[]
  symptoms      Symptom[]
  bottlenecks   Bottleneck[]
  ticketDrafts  TicketDraft[]
  rechecks      Recheck[]
  reports       Report[]

  @@map("diagnosis_sessions")
}

model CustomerFlow {
  id             String   @id @default(cuid())
  sessionId      String   @map("session_id")
  stepOrder      Int      @map("step_order")
  stepName       String   @map("step_name")
  stepType       String   @map("step_type")
  channel        String?
  description    String?  @db.Text
  expectedAction String?  @map("expected_action") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  session DiagnosisSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("customer_flows")
}

model Symptom {
  id              String   @id @default(cuid())
  sessionId       String   @map("session_id")
  title           String
  description     String?  @db.Text
  quote           String?  @db.Text
  journeyStep     String   @map("journey_step")
  severity        Int      @default(1)
  frequency       Int      @default(1)
  channel         String?
  tags            String[] @default([])
  businessImpact  Int      @default(1) @map("business_impact")
  evidenceCount   Int      @default(0) @map("evidence_count")
  bottleneckScore Float?   @map("bottleneck_score")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  session       DiagnosisSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  evidenceItems EvidenceItem[]

  @@map("symptoms")
}

model EvidenceItem {
  id        String   @id @default(cuid())
  symptomId String   @map("symptom_id")
  sessionId String   @map("session_id")
  type      String
  title     String
  content   String?  @db.Text
  fileUrl   String?  @map("file_url")
  fileName  String?  @map("file_name")
  source    String?
  createdAt DateTime @default(now()) @map("created_at")

  symptom Symptom @relation(fields: [symptomId], references: [id], onDelete: Cascade)

  @@map("evidence_items")
}

// ─── Bottleneck ───────────────────────────────────────────────────────────────

model Bottleneck {
  id                  String   @id @default(cuid())
  sessionId           String   @map("session_id")
  rank                Int
  journeyStep         String   @map("journey_step")
  label               String
  totalScore          Float    @map("total_score")
  severityScore       Float    @map("severity_score")
  frequencyScore      Float    @map("frequency_score")
  evidenceScore       Float    @map("evidence_score")
  businessImpactScore Float    @map("business_impact_score")
  symptomIds          String[] @map("symptom_ids")
  tags                String[] @default([])
  description         String?  @db.Text
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  session      DiagnosisSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  ticketDrafts TicketDraft[]

  @@map("bottlenecks")
}

// ─── Ticket ───────────────────────────────────────────────────────────────────

model TicketDraft {
  id             String   @id @default(cuid())
  bottleneckId   String?  @map("bottleneck_id")
  sessionId      String   @map("session_id")
  title          String
  priority       String   @default("medium")
  type           String   @default("improvement")
  description    String?  @db.Text
  hypothesis     String?  @db.Text
  proposedAction String?  @map("proposed_action") @db.Text
  successMetric  String?  @map("success_metric") @db.Text
  status         String   @default("draft")
  assignee       String?
  tags           String[] @default([])
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  session    DiagnosisSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  bottleneck Bottleneck?      @relation(fields: [bottleneckId], references: [id])
  rechecks   Recheck[]

  @@map("ticket_drafts")
}

// ─── Recheck ──────────────────────────────────────────────────────────────────

model Recheck {
  id           String   @id @default(cuid())
  ticketId     String   @map("ticket_id")
  sessionId    String   @map("session_id")
  checkDate    DateTime @map("check_date")
  result       String
  metricBefore String?  @map("metric_before")
  metricAfter  String?  @map("metric_after")
  note         String?  @db.Text
  checkedBy    String?  @map("checked_by")
  createdAt    DateTime @default(now()) @map("created_at")

  ticket  TicketDraft      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  session DiagnosisSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("rechecks")
}

// ─── Fruit Portfolio (과일 중심 운영 구조) ────────────────────────────────────

model Fruit {
  id                String   @id @default(cuid())
  workspaceId       String   @map("workspace_id")
  name              String                          // 딸기, 포도, 망고
  variety           String?                         // 설향, 샤인머스캣, 애플망고
  category          String?                         // 베리류, 포도류, 열대과일
  emoji             String?  @default("🍓")
  seasonStartMonth  Int      @map("season_start_month")   // 1-12
  seasonEndMonth    Int      @map("season_end_month")
  peakStartMonth    Int      @map("peak_start_month")
  peakEndMonth      Int      @map("peak_end_month")
  sourcingLeadDays  Int      @default(30) @map("sourcing_lead_days")
  marketingLeadDays Int      @default(14) @map("marketing_lead_days")
  defaultChannels   String[] @default([]) @map("default_channels")
  priorityLevel     Int      @default(2) @map("priority_level")   // 1=low 2=mid 3=high
  isActive          Boolean  @default(true) @map("is_active")
  description       String?  @db.Text
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaigns    FruitCampaign[]
  performances FruitPerformance[]
  tasks        FruitTask[]
  insights     FruitInsight[]

  @@map("fruits")
}

model FruitCampaign {
  id                 String    @id @default(cuid())
  fruitId            String    @map("fruit_id")
  workspaceId        String    @map("workspace_id")
  year               Int
  season             String                            // spring, summer, autumn, winter
  title              String
  sourcingStartDate  DateTime? @map("sourcing_start_date")
  pricingDueDate     DateTime? @map("pricing_due_date")
  contentDueDate     DateTime? @map("content_due_date")
  launchDate         DateTime? @map("launch_date")
  promoPeakStartDate DateTime? @map("promo_peak_start_date")
  promoPeakEndDate   DateTime? @map("promo_peak_end_date")
  reviewDate         DateTime? @map("review_date")
  ownerId            String?   @map("owner_id")
  status             String    @default("draft")  // draft, planned, active, completed, delayed
  notes              String?   @db.Text
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  fruit        Fruit              @relation(fields: [fruitId], references: [id], onDelete: Cascade)
  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  performances FruitPerformance[]
  tasks        FruitTask[]
  insights     FruitInsight[]

  @@map("fruit_campaigns")
}

model FruitPerformance {
  id              String   @id @default(cuid())
  fruitId         String   @map("fruit_id")
  campaignId      String?  @map("campaign_id")
  workspaceId     String   @map("workspace_id")
  channel         String
  salesAmount     Float    @default(0) @map("sales_amount")
  marginAmount    Float    @default(0) @map("margin_amount")
  marginRate      Float    @default(0) @map("margin_rate")
  csCount         Int      @default(0) @map("cs_count")
  returnRate      Float    @default(0) @map("return_rate")
  conversionRate  Float    @default(0) @map("conversion_rate")
  reviewSummary   String?  @map("review_summary") @db.Text
  nextAction      String?  @map("next_action") @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  fruit     Fruit          @relation(fields: [fruitId], references: [id], onDelete: Cascade)
  campaign  FruitCampaign? @relation(fields: [campaignId], references: [id])
  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("fruit_performances")
}

model FruitTask {
  id          String    @id @default(cuid())
  fruitId     String    @map("fruit_id")
  campaignId  String?   @map("campaign_id")
  workspaceId String    @map("workspace_id")
  type        String                        // sourcing, pricing, content, sales, review
  title       String
  assigneeId  String?   @map("assignee_id")
  dueDate     DateTime? @map("due_date")
  status      String    @default("pending") // pending, in_progress, done, delayed
  priority    String    @default("medium")  // low, medium, high, critical
  notes       String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  fruit     Fruit          @relation(fields: [fruitId], references: [id], onDelete: Cascade)
  campaign  FruitCampaign? @relation(fields: [campaignId], references: [id])
  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("fruit_tasks")
}

model FruitInsight {
  id                    String   @id @default(cuid())
  fruitId               String   @map("fruit_id")
  campaignId            String?  @map("campaign_id")
  workspaceId           String   @map("workspace_id")
  sourceYear            Int      @map("source_year")
  summary               String   @db.Text
  recommendation        String   @db.Text
  linkedToNextCampaign  Boolean  @default(false) @map("linked_to_next_campaign")
  createdAt             DateTime @default(now()) @map("created_at")

  fruit     Fruit          @relation(fields: [fruitId], references: [id], onDelete: Cascade)
  campaign  FruitCampaign? @relation(fields: [campaignId], references: [id])
  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("fruit_insights")
}

// ─── Report ───────────────────────────────────────────────────────────────────

model Report {
  id              String   @id @default(cuid())
  sessionId       String   @map("session_id")
  projectId       String   @map("project_id")
  title           String
  symptomCount    Int      @default(0) @map("symptom_count")
  bottleneckCount Int      @default(0) @map("bottleneck_count")
  ticketCount     Int      @default(0) @map("ticket_count")
  topBottleneck   String?  @map("top_bottleneck")
  summary         String?  @db.Text
  chartData       Json?    @map("chart_data")
  status          String   @default("draft")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  session DiagnosisSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("reports")
}

// ─── 성과분석 결과 저장(History) ───────────────────────────────────────────────

model PerformanceAnalysis {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  createdBy   String   @map("created_by")
  title       String
  periodStart String?  @map("period_start")
  periodEnd   String?  @map("period_end")
  seasonFlag  String?  @map("season_flag")
  engine      String?  // claude | openai | rule
  request     Json     // PerfRequest (계산된 metrics)
  result      Json     // PerfResponse (해석 결과)
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator   User      @relation("CreatedAnalyses", fields: [createdBy], references: [id])

  @@map("performance_analyses")
}

// ─── 마케팅 에이전트 (vibeX 이식) ──────────────────────────────────────────────

// 상품 마케팅 분석 (허브 엔티티)
model Analysis {
  id                  String   @id @default(cuid())
  workspaceId         String   @map("workspace_id")
  createdBy           String   @map("created_by")
  productName         String   @map("product_name")
  category            String   // single | giftset | subscription
  inputMode           String?  @map("input_mode") // text | url | file
  productInfo         String?  @map("product_info") @db.Text
  sourceUrl           String?  @map("source_url")
  fileName            String?  @map("file_name")
  attributes          Json?    // {sweetness,origin,season,storage,grade}
  targetCustomer      String?  @map("target_customer") @db.Text
  marketingCopy       String?  @map("marketing_copy") @db.Text
  seoKeywords         Json?    @map("seo_keywords") // string[]
  seasonalCampaign    String?  @map("seasonal_campaign") @db.Text
  hashtags            Json?    // string[]
  pricePositioning    String?  @map("price_positioning") @db.Text
  differentiation     String?  @db.Text
  recommendedChannels Json?    @map("recommended_channels") // [{channel,priority,reasoning}]
  thumbnailUrl        String?  @map("thumbnail_url")
  competitorInfo      String?  @map("competitor_info") @db.Text
  competitorUrl       String?  @map("competitor_url")
  competitors         Json?    // [{name,url,info}]
  marketResearch      Json?    @map("market_research") // {summary,results:[]}
  weather             Json?    // {baseDate,baseTime,temperature,rainfall,humidity}
  kamisPrices         Json?    @map("kamis_prices") // {mapping,period,items:[]}
  status              String   @default("completed")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  strategyItems  StrategyItem[]
  contentPlans   ContentPlan[]
  executionTasks ExecutionTask[]
  campaigns      MarketingCampaign[]
  forecasts      DemandForecast[]
  kamisMappings  KamisMapping[]

  @@index([workspaceId, createdAt])
  @@map("analyses")
}

// SWOT/PEST 전략 항목
model StrategyItem {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  analysisId  String   @map("analysis_id")
  framework   String   // swot | pest
  category    String   // strength|weakness|opportunity|threat | political|economic|social|technological
  content     String   @db.Text
  isSelected  Boolean  @default(false) @map("is_selected")
  assignee    String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  analysis  Analysis  @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@map("strategy_items")
}

// 채널별 콘텐츠 기획 카드
model ContentPlan {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  analysisId  String   @map("analysis_id")
  channel     String
  title       String
  description String   @db.Text
  keyPoints   Json?    @map("key_points") // string[]
  hashtags    Json?    // string[]
  status      String   @default("draft")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  analysis       Analysis        @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  executionTasks ExecutionTask[]

  @@index([analysisId])
  @@map("content_plans")
}

// 실행 타임라인 태스크
model ExecutionTask {
  id              String   @id @default(cuid())
  workspaceId     String   @map("workspace_id")
  analysisId      String   @map("analysis_id")
  contentPlanId   String?  @map("content_plan_id")
  title           String
  description     String   @db.Text
  channel         String
  priority        String   @default("medium") // high|medium|low
  recommendedDate DateTime @map("recommended_date")
  assignee        String   @default("")
  status          String   @default("pending")
  createdAt       DateTime @default(now()) @map("created_at")

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  analysis    Analysis     @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  contentPlan ContentPlan? @relation(fields: [contentPlanId], references: [id])

  @@index([analysisId])
  @@map("execution_tasks")
}

// 마케팅 캠페인 (출하/일정 캘린더 항목)
model MarketingCampaign {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  createdBy   String   @map("created_by")
  analysisId  String?  @map("analysis_id")
  title       String
  description String?  @db.Text
  category    String?
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  status      String   @default("planned") // planned|active|completed
  color       String?
  channel     String?  // SNS|KAKAO|META|ADS|BANNER|BLOG
  assignee    String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  analysis  Analysis? @relation(fields: [analysisId], references: [id])

  @@index([workspaceId, startDate])
  @@map("marketing_campaigns")
}

// 수요 예측
model DemandForecast {
  id                String   @id @default(cuid())
  workspaceId       String   @map("workspace_id")
  createdBy         String   @map("created_by")
  analysisId        String?  @map("analysis_id")
  productName       String   @map("product_name")
  origin            String?
  grade             String?
  salePrice         Float?   @map("sale_price")
  wholesalePrice    Float?   @map("wholesale_price")
  discountRate      Float?   @map("discount_rate")
  avgTemperature    Float?   @map("avg_temperature")
  rainfall          Float?
  isHoliday         Boolean  @default(false) @map("is_holiday")
  dayOfWeek         String?  @map("day_of_week")
  month             Int?
  season            String?
  previousDaySales  Float?   @map("previous_day_sales")
  lastWeekSales     Float?   @map("last_week_sales")
  lastYearSales     Float?   @map("last_year_sales")
  modelType         String?  @map("model_type")
  predictedDemand   Float?   @map("predicted_demand")
  confidenceR2      Float?   @map("confidence_r2")
  rmse              Float?
  mape              Float?
  featureImportance Json?    @map("feature_importance")
  recommendation    String?  @db.Text
  createdAt         DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  analysis  Analysis? @relation(fields: [analysisId], references: [id])

  @@index([workspaceId, createdAt])
  @@map("demand_forecasts")
}

// KAMIS 상품→시세코드 매핑
model KamisMapping {
  id           String   @id @default(cuid())
  workspaceId  String   @map("workspace_id")
  createdBy    String   @map("created_by")
  analysisId   String?  @map("analysis_id")
  productName  String   @map("product_name")
  categoryCode String   @map("category_code")
  categoryName String?  @map("category_name")
  itemCode     String   @map("item_code")
  itemName     String?  @map("item_name")
  kindCode     String?  @map("kind_code")
  kindName     String?  @map("kind_name")
  rankCode     String?  @map("rank_code")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  analysis  Analysis? @relation(fields: [analysisId], references: [id])

  @@index([workspaceId])
  @@index([productName])
  @@map("kamis_mappings")
}

// 프롬프트 템플릿 (Settings에서 편집)
model PromptTemplate {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  category    String   // single | giftset | subscription
  name        String
  description String?
  content     String   @db.Text
  variables   Json?    // string[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, category])
  @@map("prompt_templates")
}
